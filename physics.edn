;; What this occupation's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:physics` runs it.
;;
;; README "Robotics premise": a document-handling and cargo-tracking robot
;; performs customs-form printing, cargo-manifest filing and physical archival
;; (ISCO 3331 clearing and forwarding agents). Its physical work: carrying the
;; declaration packet 500 m across the container terminal to the customs
;; examination shed under the terminal speed limit, and filing manifest
;; binders on the archive shelf.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isco-3331"
 :cases
 [{:id :declaration-packet-to-exam-shed
   :kind :transport
   :procedure "robot carries the declaration packet 500 m across the container terminal to the customs examination shed"
   :params {:mass-kg 60.0 :payload-kg 5.0 :distance-m 500.0 :a-max-mps2 0.5 :max-time-s 1200.0
            :brake-decel-mps2 1.0 :drive-force-n 200.0 :crr 0.02
            :cog-height-m 0.50 :support-half-length-m 0.30}
   :sweep {:param :v-max-mps :values [0.8 1.0 1.5 2.0 2.5]}
   :quantity :cycle-time-s
   :limit {:max 480.0 :basis "estimate: packet reaches the examination shed within 8 minutes so the booked examination slot is kept"}
   :boundary {:lo 0.5 :hi 2.5}}
  {:id :manifest-binder-to-shelf
   :kind :manipulator
   :procedure "arm files a cargo-manifest binder from the print bench onto the archive shelf"
   :params {:l1-m 0.45 :l2-m 0.40 :m1-kg 3.5 :m2-kg 2.5
            :from [0.55 0.05] :to [0.20 0.70] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [0.5 1.0 2.0 4.0 6.0]}
   :quantity :peak-tau1-nm
   :limit {:max 55.0 :basis "estimate: continuous shoulder torque of a light (~5 kg-payload) collaborative arm"}
   :boundary {:lo 0.1 :hi 20.0}}]}
